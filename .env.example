# Copy to .env (repo root) for local development.
# When running from the Pterodactyl egg, these are set as egg variables instead.

# Port the panel listens on. Inside Pterodactyl, SERVER_PORT is used automatically.
PORT=8080

# The panel's own database (MySQL/MariaDB). Create one in your Pterodactyl
# server's "Databases" tab and paste its connection details here.
DATABASE_URL=mysql://ice18:devpass@127.0.0.1:3306/ice18

# Random string, at least 32 characters. Signs login sessions.
# Generate one with: openssl rand -hex 32
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Public address people open in the browser, e.g. https://panel.example.com
# Used to check where console websocket connections come from. Optional.
PUBLIC_URL=

# Your existing Pterodactyl panel.
PTERODACTYL_URL=https://panel.example.com
# Application API key (Admin -> Application API). Read servers, users, nodes.
PTERODACTYL_APP_KEY=
# Client API key of a Pterodactyl ROOT ADMIN account (Account -> API Credentials).
# Used for power actions and the live console.
PTERODACTYL_CLIENT_KEY=

# Allow anyone to create an account. The very first account can always be
# created and becomes the admin.
REGISTRATION_ENABLED=false

# Set to true when the panel is served over HTTPS.
COOKIE_SECURE=false

# Set to true when running behind a reverse proxy (Nginx, Caddy, Cloudflare).
TRUST_PROXY=false
